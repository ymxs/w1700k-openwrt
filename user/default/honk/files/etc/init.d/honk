#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/honk-core
CONF=/etc/honk/config.dae
DATA=/var/lib/honk

# honk pins its eBPF maps under bpffs; make sure it is mounted before start.
ensure_bpffs() {
    install -d -m 0755 /sys/fs/bpf
    mountpoint -q /sys/fs/bpf || mount -t bpf bpf /sys/fs/bpf
}

start_service() {
    ensure_bpffs
    install -d -m 0700 "$DATA"
    procd_open_instance honk
    procd_set_param command "$PROG" --disable-timestamp -c "$CONF"
    procd_set_param limits nofile=1048576 nproc=512
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/honk.pid
    procd_close_instance
}

reload_service() {
    "$PROG" reload
}
