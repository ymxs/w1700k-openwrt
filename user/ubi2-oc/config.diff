# ===== nikki (mihomo / Clash.Meta) transparent proxy =====
# 内核与界面包来自 nikkinikki-org/OpenWrt-nikki feed，在 user/default/feeds.conf
# 里以 src-git 接入。该文件在 CI 中被复制成 feeds.conf.default，早于
# scripts/feeds update/install 执行，所以 feed 能被正常解析（在 custom.sh
# 阶段再 clone 到 package/ 已经太晚，这也是为什么 Aurora/OpenClash 过去用
# package/ 方式接入，而 feed 类项目必须写进 feeds.conf）。
# mihomo-meta 用 OpenWrt 的 Go 工具链从源码编译，GO_PKG_TAGS=with_gvisor，
# TUN 模式可用；与 mihomo-alpha 互斥。
# mihomo 即 Clash Verge Rev / ClashX Meta / mihomo-party 使用的同一个内核。
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_mihomo-meta=y
# CONFIG_PACKAGE_mihomo-alpha is not set
# 依赖：nikki / mihomo-meta Makefile 的 DEPENDS。
# curl 在基础配置里已有（上方），此处不重复；libuci-lua / liblua 在 iStore
# 段落勾选，也不重复。
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-nft-core=y
# dnsmasq-full 通过 PROVIDES 取代默认 dnsmasq，需显式关掉默认变体；
# nftset 让 dnsmasq 能经由 nft sets 参与分流，nftables-json 供 LuCI 防火墙页用。
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_nftables-json=y
# LuCI 是 Lua 应用，必须引入 LuCI 的 Lua 兼容运行时（iStore 同样需要）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
# 脚本 / 工具类
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_unzip=y
# ===== nikki dependency end =====

# ===== iStore 应用商店 (luci-app-store) =====
# 本固件 CONFIG_USE_APK=y（default y），iStore 会据此自动选用 apk 分支
# 并内置 apk 商店源与签名公钥，无需手动配置源
CONFIG_USE_APK=y
# 主包及其自带的 3 个配套包（均来自 linkease/istore 仓库的 luci/ 目录）
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
# 商店菜单中文标题由 custom.sh 直接改写 store.lua（见 iStore 段），不依赖 luci.mk i18n 包
# 下列为上述 4 个包 DEPENDS 声明的依赖。
# 已核实在源码树本体：libuci-lua、liblua、mount-utils、script-utils、procd
# 来自 packages feed（不在源码树本体，但 CI 会跑 feeds update/install -a 拉入）：
#   tar、coreutils、coreutils-stty
# 显式写出以免 defconfig 阶段被丢弃
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_procd=y
# tar's PACKAGE_TAR_XZ option defaults to y; OpenWrt 25.x kconfig generation
# propagates that conditional requirement into every package selecting tar, so
# defconfig drops luci-app-store unless xz-utils is selected as well.
CONFIG_PACKAGE_xz-utils=y
# luci-compat / curl / luci-lua-runtime 已在 nikki 段落勾选，iStore 同样需要，不重复添加
# ===== iStore 依赖结束 =====

# ===== iStoreOS integration (istoreos-25.12) =====
# Core iStoreOS files package: Argon-based UI defaults + easepi icons,
# blockmount auto-mount, fstab LuCI menu, first-boot uci-defaults.
# Its Makefile marks it DEFAULT:=y; listed explicitly for clarity.
CONFIG_PACKAGE_istoreos-files=y
# iStoreOS default theme (jjm2473/openwrt-third feed) + its config app.
# 99_theme switches the first-boot UI to Argon; Aurora stays available.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# Dynamic kernel module loader/unloader (iStoreOS diy package)
CONFIG_PACKAGE_dkml=y
# LuCI OTA firmware flashing app (iStoreOS diy package; curl already selected)
CONFIG_PACKAGE_luci-app-ota=y
# ===== iStoreOS integration end =====
