# W1700K platform tuning - ubi2-oc (overclocked) profile.
#
# Consumed by /etc/init.d/w1700k-cpufreq on every boot.
#
# The overclocked OPP table extends the range from 1200 MHz to 1400 MHz, but
# the firmware (ATF) voltage table was not raised with it: the PM-domain PLL
# formula is shifted from "500 + state*50" to "700 + state*50", so every OPP
# runs at the voltage the firmware intended for a frequency 200 MHz lower.
# In other words ubi2-oc is a uniform ~200 MHz undervolt, not just extra
# clock headroom. Marginal DRAM/CPU state under that condition shows up as
# silent single-bit corruption, which the kernel then trips over in the timer
# tick path - the random reboot / kernel panic this profile was being blamed
# for.
#
# These settings keep the extra headroom reachable but stop the board from
# sitting in the most marginal part of the curve by default.

config cpufreq 'main'
	# Never leave the "performance" governor in place: it holds all cores at
	# the top OPP 24/7, which is precisely the undervolted worst case.
	option governor 'ondemand'

	# Cap at the vendor-rated 1.2 GHz instead of the overclocked 1.4 GHz top
	# OPP. Set to 1400000 to re-enable the full overclock, or 0 to inherit
	# the default (no cap).
	option max_freq '1200000'

	# Let the governor idle down when the router is quiet.
	option min_freq '0'
